{
  "name": "@shubhamtaywade82/ollama-client-ts",
  "version": "0.1.0",
  "description": "Production-grade TypeScript SDK for Ollama with native fetch, high availability failover, multi-turn tool calling, structured outputs, reasoning stream tokens, OpenAI/Anthropic bridges, MCP, and Web Stream adapters.",
  "keywords": [
    "ollama",
    "ollama-client",
    "ollama-sdk",
    "llm",
    "ai",
    "typescript",
    "nodejs",
    "chat",
    "streaming",
    "tool-calling",
    "function-calling",
    "agent",
    "mcp",
    "skills",
    "zod",
    "structured-outputs",
    "embeddings",
    "qwen",
    "llama"
  ],
  "license": "MIT",
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "homepage": "https://github.com/shubhamtaywade82/ollama-client-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/ollama-client-ts.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/ollama-client-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./skills": {
      "import": {
        "types": "./dist/skills.d.ts",
        "default": "./dist/skills.js"
      },
      "require": {
        "types": "./dist/skills.d.cts",
        "default": "./dist/skills.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "skills": [
        "dist/skills.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:types": "npx --yes @arethetypeswrong/cli@latest --pack .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "example": "tsx",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "zod": "^3.22.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9",
    "zod": "^4.0.0"
  }
}
