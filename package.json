{
  "name": "ollama-client-ts",
  "version": "0.1.0",
  "description": "A production-grade TypeScript SDK for Ollama. Native fetch, zero runtime dependencies, retries, timeouts, middleware, structured streaming, tool-calling, MCP, skills, and Zod-powered structured outputs.",
  "keywords": [
    "ollama",
    "llm",
    "sdk",
    "typescript",
    "ai",
    "chat",
    "streaming",
    "tool-calling",
    "function-calling",
    "agent",
    "mcp",
    "skills",
    "zod",
    "structured-outputs"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./skills": {
      "import": {
        "types": "./dist/skills.d.ts",
        "default": "./dist/skills.js"
      },
      "require": {
        "types": "./dist/skills.d.cts",
        "default": "./dist/skills.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "example": "tsx",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/ollama-client-ts.git"
  },
  "homepage": "https://github.com/shubhamtaywade82/ollama-client-ts#readme",
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/ollama-client-ts/issues"
  },
  "author": "shubhamtaywade82"
}
